[Interface]
Address = {{ wg_address }}
{% if wg_listen_port is defined %}
ListenPort = {{ wg_listen_port }}
{% endif %}
PrivateKey = {{ wireguard_private_key }}
{% if wg_postup is defined %}
PostUp = {{ wg_postup }}
PostDown = {{ wg_postdown }}
{% endif %}

[Peer]
PublicKey = {{ hostvars[wg_peer].wireguard_public_key }}
AllowedIPs = {{ wg_peer_allowed_ips }}
{% if wg_endpoint is defined %}
Endpoint = {{ wg_endpoint }}
{% endif %}
PersistentKeepalive = 25
